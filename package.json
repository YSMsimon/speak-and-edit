{
  "name": "speak-and-edit",
  "description": "Say an edit in Google Meet and it lands in your Google Doc, Sheet or Slides, credited to whoever said it. Full edition: also Obsidian and Overleaf.",
  "private": true,
  "license": "MIT",
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:full": "SCRIBE_FULL=1 wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:full": "SCRIBE_FULL=1 wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:store": "env -u SCRIBE_FULL -u SCRIBE_SMOKE -u SCRIBE_SCREENS SCRIBE_STORE=1 SCRIBE_OUT=.output-store wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@base-ui/react": "1.9.0",
    "@browser-ai/core": "3.0.4",
    "@fontsource-variable/geist": "5.3.0",
    "@paper-design/shaders-react": "0.0.82",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "ai": "7.0.159",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.5.1",
    "double-metaphone": "2.0.1",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "nanoid": "6.0.2",
    "radix-ui": "1.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "4.23.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tokenlens": "1.3.1",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/selfhst": "1.2.26",
    "@iconify-json/thesvg-color": "1.2.22",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.1.5",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
